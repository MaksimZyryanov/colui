{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppErrorCodeDto": {
      "enum": [
        "runtime_unavailable",
        "runtime_connection_failed",
        "runtime_context_mismatch",
        "profile_not_found",
        "profile_already_registered",
        "profile_revision_conflict",
        "profile_invalid",
        "definition_failed",
        "compose_failed",
        "container_operation_failed",
        "operation_conflict",
        "operation_timeout",
        "registry_corrupt",
        "registry_locked",
        "registry_write_failed",
        "permission_denied",
        "protocol_mismatch"
      ],
      "type": "string"
    },
    "AppErrorDto": {
      "properties": {
        "code": {
          "$ref": "#/definitions/AppErrorCodeDto"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "subjectId": {
          "anyOf": [
            {
              "$ref": "#/definitions/UuidSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "operation",
        "retryable"
      ],
      "type": "object"
    },
    "ContainerInstanceDto": {
      "properties": {
        "id": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "publishedPorts": {
          "items": {
            "$ref": "#/definitions/PortBindingDto"
          },
          "type": "array"
        },
        "serviceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/ContainerStateDto"
        },
        "statusText": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "image",
        "name",
        "publishedPorts",
        "state",
        "statusText"
      ],
      "type": "object"
    },
    "ContainerStateDto": {
      "enum": [
        "running",
        "stopped",
        "unknown"
      ],
      "type": "string"
    },
    "DaemonFingerprintDto": {
      "properties": {
        "architecture": {
          "type": "string"
        },
        "daemonId": {
          "type": "string"
        },
        "osType": {
          "type": "string"
        },
        "serverVersion": {
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "daemonId",
        "osType",
        "serverVersion"
      ],
      "type": "object"
    },
    "InventoryFreshnessDto": {
      "enum": [
        "fresh",
        "stale",
        "unavailable"
      ],
      "type": "string"
    },
    "PortBindingDto": {
      "properties": {
        "containerPort": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "hostIp": {
          "type": "string"
        },
        "hostPort": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "protocol": {
          "type": "string"
        }
      },
      "required": [
        "containerPort",
        "hostIp",
        "hostPort",
        "protocol"
      ],
      "type": "object"
    },
    "ProjectRuntimeSnapshotDto": {
      "properties": {
        "composeProjectName": {
          "type": "string"
        },
        "configFiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "containers": {
          "items": {
            "$ref": "#/definitions/ContainerInstanceDto"
          },
          "type": "array"
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "composeProjectName",
        "configFiles",
        "containers"
      ],
      "type": "object"
    },
    "Rfc3339Schema": {
      "format": "date-time",
      "type": "string"
    },
    "UuidSchema": {
      "format": "uuid",
      "type": "string"
    }
  },
  "properties": {
    "containers": {
      "items": {
        "$ref": "#/definitions/ContainerInstanceDto"
      },
      "type": "array"
    },
    "daemonFingerprint": {
      "anyOf": [
        {
          "$ref": "#/definitions/DaemonFingerprintDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/AppErrorDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "$ref": "#/definitions/InventoryFreshnessDto"
    },
    "generation": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "hasSnapshot": {
      "type": "boolean"
    },
    "lastSuccessfulObservedAt": {
      "anyOf": [
        {
          "$ref": "#/definitions/Rfc3339Schema"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedAt": {
      "anyOf": [
        {
          "$ref": "#/definitions/Rfc3339Schema"
        },
        {
          "type": "null"
        }
      ]
    },
    "projects": {
      "items": {
        "$ref": "#/definitions/ProjectRuntimeSnapshotDto"
      },
      "type": "array"
    },
    "runtimeSessionId": {
      "anyOf": [
        {
          "$ref": "#/definitions/UuidSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "standaloneContainers": {
      "items": {
        "$ref": "#/definitions/ContainerInstanceDto"
      },
      "type": "array"
    }
  },
  "required": [
    "containers",
    "freshness",
    "generation",
    "hasSnapshot",
    "projects",
    "standaloneContainers"
  ],
  "title": "RuntimeInventoryDto",
  "type": "object"
}
