{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppErrorCodeDto": {
      "enum": [
        "runtime_unavailable",
        "runtime_connection_failed",
        "runtime_context_mismatch",
        "candidate_stale",
        "discovery_conflict",
        "profile_not_found",
        "profile_already_registered",
        "profile_revision_conflict",
        "profile_invalid",
        "definition_failed",
        "compose_failed",
        "container_operation_failed",
        "operation_conflict",
        "operation_timeout",
        "registry_corrupt",
        "registry_locked",
        "registry_write_failed",
        "recovery_conflict",
        "permission_denied",
        "protocol_mismatch"
      ],
      "type": "string"
    },
    "AppErrorDto": {
      "properties": {
        "code": {
          "$ref": "#/definitions/AppErrorCodeDto"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/definitions/AppErrorSubjectDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "operation",
        "retryable"
      ],
      "type": "object"
    },
    "AppErrorSubjectDto": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/AppErrorSubjectKindDto"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "AppErrorSubjectKindDto": {
      "enum": [
        "profile",
        "candidate",
        "container",
        "registry"
      ],
      "type": "string"
    },
    "DaemonFingerprintDto": {
      "properties": {
        "architecture": {
          "type": "string"
        },
        "daemonId": {
          "type": "string"
        },
        "osType": {
          "type": "string"
        },
        "serverVersion": {
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "daemonId",
        "osType",
        "serverVersion"
      ],
      "type": "object"
    },
    "MismatchDetailsDto": {
      "properties": {
        "apiFingerprint": {
          "$ref": "#/definitions/DaemonFingerprintDto"
        },
        "cliFingerprint": {
          "$ref": "#/definitions/DaemonFingerprintDto"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "required": [
        "apiFingerprint",
        "cliFingerprint",
        "endpoint"
      ],
      "type": "object"
    },
    "Rfc3339Schema": {
      "format": "date-time",
      "type": "string"
    },
    "RuntimeStateDto": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "enum": [
                "disconnected"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "enum": [
                "connecting"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "context": {
              "$ref": "#/definitions/SessionContextDto"
            },
            "state": {
              "enum": [
                "ready"
              ],
              "type": "string"
            }
          },
          "required": [
            "context",
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "details": {
              "$ref": "#/definitions/MismatchDetailsDto"
            },
            "state": {
              "enum": [
                "contextMismatch"
              ],
              "type": "string"
            }
          },
          "required": [
            "details",
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "#/definitions/AppErrorDto"
            },
            "state": {
              "enum": [
                "failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "error",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "SessionContextDto": {
      "properties": {
        "connectedAt": {
          "format": "date-time",
          "type": "string"
        },
        "daemonFingerprint": {
          "$ref": "#/definitions/DaemonFingerprintDto"
        },
        "endpoint": {
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "connectedAt",
        "daemonFingerprint",
        "endpoint",
        "sessionId"
      ],
      "type": "object"
    },
    "UuidSchema": {
      "format": "uuid",
      "type": "string"
    }
  },
  "properties": {
    "apiFingerprint": {
      "anyOf": [
        {
          "$ref": "#/definitions/DaemonFingerprintDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "cliFingerprint": {
      "anyOf": [
        {
          "$ref": "#/definitions/DaemonFingerprintDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "connectedAt": {
      "anyOf": [
        {
          "$ref": "#/definitions/Rfc3339Schema"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolvedEndpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionId": {
      "anyOf": [
        {
          "$ref": "#/definitions/UuidSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/definitions/RuntimeStateDto"
    }
  },
  "required": [
    "state"
  ],
  "title": "RuntimeDiagnosticsDto",
  "type": "object"
}
