      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "registrationOrigin": {
      "$ref": "#/definitions/RegistrationOriginDto"
    },
    "revision": {
