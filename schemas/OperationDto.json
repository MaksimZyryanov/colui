        "apply",
        "stop",
        "tear-down",
        "restart"
      ],
      "type": "string"
    },
    "OperationPhaseDto": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "kind": {
      "$ref": "#/definitions/OperationKindDto"
    },
    "phase": {
      "$ref": "#/definitions/OperationPhaseDto"
    },
    "startedAt": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "phase",
    "startedAt"
  ],
  "title": "OperationDto",
  "type": "object"
}
