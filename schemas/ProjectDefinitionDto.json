{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppErrorCodeDto": {
      "enum": [
        "runtime_unavailable",
        "runtime_connection_failed",
        "runtime_context_mismatch",
        "candidate_stale",
        "discovery_conflict",
        "profile_not_found",
        "profile_already_registered",
        "profile_revision_conflict",
        "profile_invalid",
        "definition_failed",
        "compose_failed",
        "container_operation_failed",
        "operation_conflict",
        "operation_timeout",
        "registry_corrupt",
        "registry_locked",
        "registry_write_failed",
        "recovery_conflict",
        "permission_denied",
        "protocol_mismatch"
      ],
      "type": "string"
    },
    "AppErrorDto": {
      "properties": {
        "code": {
          "$ref": "#/definitions/AppErrorCodeDto"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/definitions/AppErrorSubjectDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "operation",
        "retryable"
      ],
      "type": "object"
    },
    "AppErrorSubjectDto": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/AppErrorSubjectKindDto"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "AppErrorSubjectKindDto": {
      "enum": [
        "profile",
        "candidate",
        "container",
        "registry"
      ],
      "type": "string"
    },
    "DefinitionStateDto": {
      "enum": [
        "unchecked",
        "valid",
        "invalid",
        "stale"
      ],
      "type": "string"
    },
    "IssueDto": {
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "Rfc3339Schema": {
      "format": "date-time",
      "type": "string"
    },
    "ServiceDefinitionDto": {
      "properties": {
        "buildContext": {
          "type": [
            "string",
            "null"
          ]
        },
        "declaredPorts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "declaredPorts",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "definitionRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/AppErrorDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "items": {
        "$ref": "#/definitions/IssueDto"
      },
      "type": "array"
    },
    "loadedAt": {
      "anyOf": [
        {
          "$ref": "#/definitions/Rfc3339Schema"
        },
        {
          "type": "null"
        }
      ]
    },
    "profileId": {
      "format": "uuid",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/definitions/ServiceDefinitionDto"
      },
      "type": "array"
    },
    "state": {
      "$ref": "#/definitions/DefinitionStateDto"
    }
  },
  "required": [
    "issues",
    "profileId",
    "services",
    "state"
  ],
  "title": "ProjectDefinitionDto",
  "type": "object"
}
