{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DefinitionStateDto": {
      "enum": [
        "unchecked",
        "valid",
        "invalid",
        "stale"
      ],
      "type": "string"
    },
    "IssueDto": {
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "Rfc3339Schema": {
      "format": "date-time",
      "type": "string"
    },
    "ServiceDefinitionDto": {
      "properties": {
        "buildContext": {
          "type": [
            "string",
            "null"
          ]
        },
        "declaredPorts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "declaredPorts",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "definitionRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "issues": {
      "items": {
        "$ref": "#/definitions/IssueDto"
      },
      "type": "array"
    },
    "loadedAt": {
      "anyOf": [
        {
          "$ref": "#/definitions/Rfc3339Schema"
        },
        {
          "type": "null"
        }
      ]
    },
    "profileId": {
      "format": "uuid",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/definitions/ServiceDefinitionDto"
      },
      "type": "array"
    },
    "state": {
      "$ref": "#/definitions/DefinitionStateDto"
    }
  },
  "required": [
    "issues",
    "profileId",
    "services",
    "state"
  ],
  "title": "ProjectDefinitionDto",
  "type": "object"
}
