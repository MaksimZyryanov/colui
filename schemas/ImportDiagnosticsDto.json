{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppErrorCodeDto": {
      "enum": [
        "runtime_unavailable",
        "runtime_connection_failed",
        "runtime_context_mismatch",
        "candidate_stale",
        "discovery_conflict",
        "profile_not_found",
        "profile_already_registered",
        "profile_revision_conflict",
        "profile_invalid",
        "definition_failed",
        "compose_failed",
        "container_operation_failed",
        "operation_conflict",
        "operation_timeout",
        "registry_corrupt",
        "registry_locked",
        "registry_write_failed",
        "recovery_conflict",
        "permission_denied",
        "protocol_mismatch"
      ],
      "type": "string"
    },
    "AppErrorDto": {
      "properties": {
        "code": {
          "$ref": "#/definitions/AppErrorCodeDto"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/definitions/AppErrorSubjectDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "operation",
        "retryable"
      ],
      "type": "object"
    },
    "AppErrorSubjectDto": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/AppErrorSubjectKindDto"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "AppErrorSubjectKindDto": {
      "enum": [
        "profile",
        "candidate",
        "container",
        "registry"
      ],
      "type": "string"
    }
  },
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/AppErrorDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "importedCount": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "sourcePath": {
      "type": "string"
    },
    "sourcePreserved": {
      "type": "boolean"
    }
  },
  "required": [
    "importedCount",
    "sourcePath",
    "sourcePreserved"
  ],
  "title": "ImportDiagnosticsDto",
  "type": "object"
}
