{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContainerInstanceDto": {
      "properties": {
        "id": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "publishedPorts": {
          "items": {
            "$ref": "#/definitions/PortBindingDto"
          },
          "type": "array"
        },
        "serviceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/ContainerStateDto"
        },
        "statusText": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "image",
        "name",
        "publishedPorts",
        "state",
        "statusText"
      ],
      "type": "object"
    },
    "ContainerStateDto": {
      "enum": [
        "running",
        "stopped",
        "unknown"
      ],
      "type": "string"
    },
    "PortBindingDto": {
      "properties": {
        "containerPort": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "hostIp": {
          "type": "string"
        },
        "hostPort": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "protocol": {
          "type": "string"
        }
      },
      "required": [
        "containerPort",
        "hostIp",
        "hostPort",
        "protocol"
      ],
      "type": "object"
    }
  },
  "properties": {
    "composeProjectName": {
      "type": "string"
    },
    "configFiles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "containers": {
      "items": {
        "$ref": "#/definitions/ContainerInstanceDto"
      },
      "type": "array"
    },
    "workingDirectory": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "composeProjectName",
    "configFiles",
    "containers"
  ],
  "title": "ProjectRuntimeSnapshotDto",
  "type": "object"
}
