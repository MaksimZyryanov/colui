{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "candidateId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "composeProjectName": {
      "type": "string"
    },
    "configFiles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "inventoryGeneration": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "runtimeSessionId": {
      "format": "uuid",
      "type": "string"
    },
    "workingDirectory": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "candidateId",
    "composeProjectName",
    "configFiles",
    "inventoryGeneration",
    "runtimeSessionId"
  ],
  "title": "RegisterCandidateRequestDto",
  "type": "object"
}
