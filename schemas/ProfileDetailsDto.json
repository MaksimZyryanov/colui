{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProfileSummaryDto": {
      "properties": {
        "composeProjectName": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "registrationOrigin": {
          "$ref": "#/definitions/RegistrationOriginDto"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "required": [
        "composeProjectName",
        "displayName",
        "id",
        "registrationOrigin",
        "revision",
        "workingDirectory"
      ],
      "type": "object"
    },
    "RegistrationOriginDto": {
      "enum": [
        "manual",
        "discovered",
        "migrated"
      ],
      "type": "string"
    }
  },
  "properties": {
    "composeFiles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "environmentFiles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile": {
      "$ref": "#/definitions/ProfileSummaryDto"
    }
  },
  "required": [
    "composeFiles",
    "environmentFiles",
    "profile"
  ],
  "title": "ProfileDetailsDto",
  "type": "object"
}
